{
  // ==================== 1. 模型与部署 ====================

  // 用于结果目录名称；也可用命令行 --model 临时覆盖。
  "model_name": "example-model",

  // mode 可选 "PD" 或 "IFB"（不区分大小写）。
  // PD：只使用 P、D 数组；IFB：只使用 IFB 数组，另一模式的节点会被忽略。
  // 节点名必须能从跳板机直接 ssh；同一个生效分组中不要重复填写节点。
  "deployment": {
    "mode": "PD",
    "groups": {
      "P": ["p1c0", "p1c1"],
      "D": ["p1c2", "p1c3"],
      "IFB": []
    }
  },

  // 每个节点预期的 DCU 数量；数量不符时仅告警，仍记录已识别的卡。
  "expected_dcu_cards_per_node": 4,


  // ==================== 2. 运行控制 ====================

  // 0：持续记录直到 Ctrl+C；大于0：记录指定秒数后自动结束。
  // 路由端口状态和稳态状态都不会控制采集的开始或结束。
  "monitor_duration_s": 0,


  // ==================== 3. 稳态判断（总开关） ====================

  // enabled 是稳态功能的唯一总开关：
  // true ：采集结束后同时计算“统一稳态”和“每节点独立稳态”，在 HTML 中用按钮切换；
  // false：完全关闭稳态判断，两种统计口径都直接使用脚本全程。
  // 无论是否开启，原始 CSV 都始终保留脚本从启动到结束的全部数据。
  "steady_state": {
    "enabled": true,

    // 只影响“统一稳态”："auto" 在PD中默认参考D节点，在IFB中默认参考IFB节点。
    // “每节点独立稳态”始终使用该节点自己的四卡平均利用率，不受此项影响。
    "reference_group": "auto",

    // 稳态开始：最近若干个真实 DCU 利用率样本组成窗口，比较窗口前后两半的均值。
    "window_fresh_samples": 6,          // 窗口包含的真实新样本数；5秒刷新时约覆盖25秒
    "confirm_windows": 2,               // 连续多少个窗口满足条件后确认开始
    "active_threshold_pct": 5,          // 窗口平均利用率至少达到该值，单位 %
    "max_half_mean_change_pct": 10,     // 前后半窗均值允许的最大相对变化，单位 %

    // 稳态结束：利用率持续回落到空闲阈值以下。
    "idle_threshold_pct": 2,            // 空闲阈值，单位 %
    "idle_confirm_samples": 2           // 连续多少个真实样本低于阈值后确认结束
  },


  // ==================== 4. 路由端口标记 ====================

  // 只标记端口可访问/不可访问的时间，不控制采集，也不参与稳态判断或数据筛选。
  "route_probe": {
    "enabled": false,
    "host": "p1c0",                    // 从跳板机能够访问的路由主机
    "port": 8000,                       // 业务端口
    "interval_s": 1,                    // TCP 探测间隔，秒
    "connect_timeout_s": 0.5,           // 单次连接超时，秒
    "successes_to_reachable": 1,        // 连续成功多少次确认“可访问”
    "failures_to_unreachable": 3        // 连续失败多少次确认“不可访问”
  },


  // ==================== 5. 采样周期 ====================

  // CPU利用率、CPU频率、主机内存、IB和DCU功耗等基础指标的采样周期，单位秒。
  "sample_interval_s": 2,

  // 下列较慢指标使用独立刷新周期；两次刷新之间复用最近一次成功值。
  "dcu_utilization_interval_s": 5,      // 最近1秒 active ratio；命令约耗时4秒，5秒接近合理下限
  "dcu_memory_interval_s": 10,          // 显存容量与占用量
  "dcu_temperature_interval_s": 5,      // DCU温度
  "cpu_temperature_interval_s": 5,      // CPU温度
  "cpu_power_interval_s": 5,            // CPU功耗
  "node_power_interval_s": 5,           // 整机功耗


  // ==================== 6. 采集命令 ====================

  // DCU 主命令：读取单卡功耗等信息；其中瞬时 HCU use 不作为最终利用率。
  "dcu_command": "hy-smi --showuse --showmemuse --showpower --json",

  // DCU 利用率采用最近1秒 HCU active ratio，避免瞬时采样漏掉推理脉冲。
  "dcu_utilization_command": "hy-smi --showhcuutil",
  "dcu_memory_command": "hy-smi --showmeminfo vram --json",
  "dcu_temperature_command": "hy-smi --showtemp --json",

  // 当前机型从 BMC 的 CPU_POWER 传感器读取 CPU 总功耗，单位 W。
  "cpu_power_command": "sudo ipmitool sensor get CPU_POWER | awk '/Sensor Reading/ {print $4; exit}'",

  // auto：从 k10temp/CPU/Package/Tctl/Tdie 等 hwmon 传感器计算平均和最高温度。
  "cpu_temperature_command": "auto",

  // 从 BMC 读取每个计算节点的整机功耗。
  "node_power_command": "ipmitool dcmi power reading",


  // ==================== 7. SSH 连接 ====================

  // 跳板机连接每个计算节点时使用的 SSH 参数。
  "ssh_options": [
    "-o", "BatchMode=yes",
    "-o", "ConnectTimeout=8",
    "-o", "ServerAliveInterval=15"
  ]


  // ==================== 8. 常用运行与结果查看 ====================
  // 命令行 --model 会覆盖 model_name，并用于结果目录名称：
  // python3 cluster_monitor.py --model DeepSeek-V3
  //
  // 查看方式1：用 SCP/SFTP 下载 results/ 下对应的整个结果文件夹，打开 dashboard.html。
  //             不能只下载 HTML，否则同目录中的 SVG 无法加载。
  //
  // 查看方式2：在 Windows 本地终端建立 SSH 隧道并保持终端运行：
  // ssh -p {SSH_PORT} -L 18080:127.0.0.1:18080 {USER}@{JUMP_HOST} "cd {PROJECT_PATH}/results && python3 -m http.server 18080 --bind 127.0.0.1"
  // 虚拟示例：ssh -p 2222 -L 18080:127.0.0.1:18080 root@192.0.2.10 "cd /root/dcu_monitor/results && python3 -m http.server 18080 --bind 127.0.0.1"
  // 然后打开 http://127.0.0.1:18080/；按 Ctrl+C 停止服务和隧道。
}
