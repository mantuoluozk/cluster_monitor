{
  // ==================== 1. 模型与部署 ====================

  // 用于结果目录名称；也可用命令行 --model 临时覆盖。
  "model_name": "example-model",

  // mode 可选 "PD" 或 "IFB"（不区分大小写）。
  // PD：只使用 P、D 数组；IFB：只使用 IFB 数组，另一模式的节点会被忽略。
  // 节点名必须能从跳板机直接 ssh；同一个生效分组中不要重复填写节点。
  "deployment": {
    "mode": "PD",
    "groups": {
      "P": ["p1c0", "p1c1"],
      "D": ["p1c2", "p1c3"],
      "IFB": []
    }
  },

  // 每个节点预期的 DCU 数量；数量不符时仅告警，仍记录已识别的卡。
  "expected_dcu_cards_per_node": 4,


  // ==================== 2. 运行控制 ====================

  // 0：持续记录直到 Ctrl+C；大于0：记录指定秒数后自动结束。
  // 路由端口状态和稳态状态都不会控制采集的开始或结束。
  "monitor_duration_s": 0,


  // ==================== 3. 稳态判断参数 ====================

  // HTML 始终提供三个统计口径按钮：
  // 1. “无稳态判断”：默认选中，始终使用脚本从启动到结束的全部有效样本；
  // 2. “统一稳态区间”：所有节点使用自动检测出的同一个稳态区间；
  // 3. “每节点独立区间”：每个节点使用自己自动检测出的稳态区间。
  // 程序始终计算统一稳态和每节点独立稳态；未检测到时对应页面保持为空。
  // 这里仅配置检测算法参数，不再提供总开关。
  // 原始 CSV 和 full_summary.csv 始终保留脚本全程数据。
  "steady_state": {
    // 只影响“统一稳态”：“auto” 在PD中分别分析P和D，自动选择更稳定且持续时间有效的区间；
    // 在IFB中参考全部IFB节点。也可显式填写 "P" 或 "D"，强制只使用指定组。
    // “每节点独立稳态”始终使用该节点自己的四卡平均利用率，不受此项影响。
    "reference_group": "auto",

    // 稳态开始：最近若干个真实 DCU 利用率样本组成窗口，比较窗口前后两半的均值。
    "window_fresh_samples": 6,          // 窗口包含的真实新样本数；1秒刷新时约覆盖5秒
    "confirm_windows": 2,               // 连续多少个窗口满足条件后确认开始
    "active_threshold_pct": 5,          // 窗口平均利用率至少达到该值，单位 %
    "max_half_mean_change_pct": 10,     // 前后半窗均值允许的最大相对变化，单位 %

    // 稳态结束：利用率持续回落到空闲阈值以下。
    "idle_threshold_pct": 2,            // 空闲阈值，单位 %
    "idle_confirm_samples": 2           // 连续多少个真实样本低于阈值后确认结束
  },


  // ==================== 4. 路由端口标记 ====================

  // 只标记端口可访问/不可访问的时间，不控制采集，也不参与稳态判断或数据筛选。
  "route_probe": {
    "enabled": false,
    "host": "p1c0",                    // 从跳板机能够访问的路由主机
    "port": 8000,                       // 业务端口
    "interval_s": 1,                    // TCP 探测间隔，秒
    "connect_timeout_s": 0.5,           // 单次连接超时，秒
    "successes_to_reachable": 1,        // 连续成功多少次确认“可访问”
    "failures_to_unreachable": 3        // 连续失败多少次确认“不可访问”
  },


  // ==================== 5. 采样周期 ====================

  // 全部基础指标按固定节拍采集；程序会扣除命令耗时，避免实际周期变成“命令耗时+1秒”。
  "sample_interval_s": 1,

  // 下列指标也每秒执行一次；命令失败时仅复用最近一次成功值。
  "dcu_utilization_interval_s": 1,      // 仅在启用下面的独立利用率命令时使用
  "dcu_memory_interval_s": 1,           // 显存容量与占用量
  "dcu_temperature_interval_s": 1,      // DCU温度
  "cpu_temperature_interval_s": 1,      // CPU温度
  "cpu_power_interval_s": 1,            // CPU功耗
  "node_power_interval_s": 1,           // 整机功耗


  // ==================== 6. 采集命令 ====================

  // DCU 主命令：一次调用读取单卡利用率、显存、功耗和温度，实测约0.08秒。
  "dcu_command": "hy-smi --showuse --showmemuse --showpower --showmeminfo vram --showtemp --json",

  // 留空时直接采用上面主命令的 showuse，实测约0.03秒；如需兼容旧口径可填
  // "hy-smi --showhcuutil"，但该命令实测约4秒，无法做到每秒返回一个新样本。
  "dcu_utilization_command": "",
  // 当前主命令已包含显存和温度，留空可避免重复查询；旧版 hy-smi 不支持组合参数时可单独配置。
  "dcu_memory_command": "",
  "dcu_temperature_command": "",

  // 当前机型从 BMC 的 CPU_POWER 传感器读取 CPU 总功耗，单位 W。
  "cpu_power_command": "sudo ipmitool sensor get CPU_POWER | awk '/Sensor Reading/ {print $4; exit}'",

  // auto：从 k10temp/CPU/Package/Tctl/Tdie 等 hwmon 传感器计算平均和最高温度。
  "cpu_temperature_command": "auto",

  // 从 BMC 读取每个计算节点的整机功耗。
  "node_power_command": "ipmitool dcmi power reading",


  // ==================== 7. SSH 连接 ====================

  // 跳板机连接每个计算节点时使用的 SSH 参数。
  "ssh_options": [
    "-o", "BatchMode=yes",
    "-o", "ConnectTimeout=8",
    "-o", "ServerAliveInterval=15"
  ]


  // ==================== 8. 常用运行与结果查看 ====================
  // 命令行 --model 会覆盖 model_name，并用于结果目录名称：
  // python3 cluster_monitor.py --model DeepSeek-V3
  //
  // 查看方式1：用 SCP/SFTP 下载 results/ 下对应的整个结果文件夹，打开 dashboard.html。
  //             不能只下载 HTML，否则同目录中的 SVG 无法加载。
  //
  // 查看方式2：在 Windows 本地终端建立 SSH 隧道并保持终端运行：
  // ssh -tt -p {SSH_PORT} -L 18080:127.0.0.1:18080 {USER}@{JUMP_HOST} "cd {PROJECT_PATH}/results && exec python3 -m http.server 18080 --bind 127.0.0.1"
  // 将四个大括号占位符替换为当前环境的实际值，然后打开 http://127.0.0.1:18080/。
  // -tt + exec 会把 Ctrl+C 传给远端 HTTP 服务，并同时结束 SSH 隧道。
}
